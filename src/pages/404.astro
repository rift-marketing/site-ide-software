---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página não encontrada — IDE Software"
  description="O endereço acessado não existe no site da IDE Software."
>
  <section class="empty">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Esta página não faz parte do site.</h1>
      <p class="lede">O endereço pode ter mudado ou sido digitado com um erro.</p>
      <div class="hero-actions">
        <a class="button" href="/">Voltar ao início</a>
        <a class="button secondary" href="/contato">Falar com a empresa</a>
      </div>
    </div>
  </section>
</Base>
