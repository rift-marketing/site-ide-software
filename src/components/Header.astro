---
import { company, nav } from "../data/site";

const path = Astro.url.pathname;
---

<div class="stripe">
  <div class="wrap stripe-inner">
    <span>{company.legalName} · {company.city}</span>
    <span>Software sob encomenda</span>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/" aria-label={`${company.name}, página inicial`}>
      <span class="mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="logo-text">
        <strong>IDE</strong>
        <em>Software</em>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="button" href="/contato">Falar com a empresa</a>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const button = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.querySelector<HTMLElement>("#site-nav");
    if (!button || !nav || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const close = () => {
      nav.classList.remove("is-open");
      button.setAttribute("aria-expanded", "false");
      button.textContent = "Menu";
    };

    button.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? "Fechar" : "Menu";
    });

    nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  }

  setupNav();
  document.addEventListener("astro:page-load", setupNav);
</script>
